<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB Host: cihazı USB bellek olarak görmek ve kontrol etmek için -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- USB oturum yönetimi -->
    <uses-permission android:name="android.permission.MANAGE_USB" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ISO dosyası seçme / yazma hedefi olarak kullanma -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Rootlu cihazlarda /dev/block erişimi için SU istemi uygulama içinde yapılır,
         ek izin gerekmez. -->

    <application
        android:name=".UsbForgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UsbForge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.UsbForge">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB bellek takıldığında uygulamayı uyandır -->
            <intent-filter>
                <action android:name="android.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" android:scheme="file" />
                <data android:mimeType="*/*" android:scheme="content" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- USB izin (permission) sonucunu almak için -->
        <receiver
            android:name=".usb.UsbPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.usbforge.USB_PERMISSION" />
            </intent-filter>
        </receiver>

        <service
            android:name=".job.WriteJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
